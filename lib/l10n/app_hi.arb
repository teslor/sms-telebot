  "error_rateLimited": "आप बहुत तेज़ी से अनुरोध भेज रहे हैं। कृपया कुछ देर प्रतीक्षा करें।",
  "error_serverError": "सर्वर वर्तमान में उपलब्ध नहीं है। कृपया बाद में प्रयास करें।",
  "error_smtpAddressRejected": "सर्वर ने प्रेषक या प्राप्तकर्ता का ईमेल अस्वीकार कर दिया। पते जांचें।",
  "error_smtpError": "सर्वर ने त्रुटि लौटाई। दर्ज किए गए कनेक्शन पैरामीटर जांचें।",
  "error_smtp_forbidden": "कार्रवाई सर्वर द्वारा अस्वीकार कर दी गई। एक्सेस अधिकार जांचें।",
  "error_smtp_unauthorized": "प्राधिकरण त्रुटि। लॉगिन और पासवर्ड जांचें।",
  "error_tbot_forbidden": "Telegram ने इस कार्रवाई को रोक दिया। सुनिश्चित करें कि बॉट के पास चैट का एक्सेस है।",
  "error_tbot_conflict": "चैट आईडी प्राप्त नहीं हो सकी। सक्रिय वेबहुक हटाएं या आईडी मैन्युअल रूप से दर्ज करें।",
  "error_tbot_unauthorized": "प्राधिकरण त्रुटि। सही टोकन दर्ज करें और फिर से प्रयास करें।",
  "error_tbot_uninitialized": "चैट आईडी प्राप्त नहीं हो सकी। Telegram में अपने बॉट के साथ संवाद शुरू करें और फिर से प्रयास करें।",
  "error_unexpectedError": "एक अप्रत्याशित त्रुटि हुई। कृपया बाद में प्रयास करें।",
  "error_secretsError": "सुरक्षित स्टोरेज तक पहुंच नहीं हो सकी। फिर से प्रयास करें। यदि त्रुटि बनी रहती है, तो ऐप को पुनः शुरू करें और फ़ॉरवर्डिंग नियमों में पासवर्ड/टोकन जांचें।",
  "warn_secretsRecovered": "क्रैश के बाद सुरक्षित स्टोरेज पुनर्प्राप्त किया गया; सहेजे गए पासवर्ड/टोकन हटाए गए हो सकते हैं। फ़ॉरवर्डिंग नियम जांचें और डेटा फिर से दर्ज करें।",
